{
  "id": "cpu-control",
  "name": "CPU frequency control",
  "version": "0.1.0",
  "description": "Choose available governors and maximum frequencies for this device’s CPU policies.",
  "backend": "root",
  "runtime": "binary",
  "hooks": {
    "enable": "native-power",
    "configure": "native-power",
    "inspect": "native-power",
    "run": "native-power",
    "disable": "native-power"
  },
  "ui": {
    "layout": "accordion",
    "cpuPolicies": true,
    "presentation": {
      "icon": "cpu"
    },
    "monitor": "cpu"
  }
}
