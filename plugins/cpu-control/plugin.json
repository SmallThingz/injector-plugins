{
  "id": "cpu-control",
  "name": "CPU frequency control",
  "version": "0.1",
  "description": "For amethyst on HyperOS OS3.0.303.0.WOPINXM. Current system frequency limits can prevent applying the efficiency-core ceiling.",
  "backend": "root",
  "runtime": "shell",
  "hooks": {
    "enable": "hook.sh",
    "run": "hook.sh",
    "disable": "hook.sh"
  },
  "ui": {
    "layout": "accordion",
    "groups": [
      {
        "id": "policy0",
        "label": "Efficiency cores · CPUs 0–3"
      },
      {
        "id": "policy4",
        "label": "Performance cores · CPUs 4–6"
      },
      {
        "id": "policy7",
        "label": "Prime core · CPU 7"
      }
    ],
    "inputs": [
      {
        "id": "policy0_governor",
        "group": "policy0",
        "label": "Frequency governor",
        "type": "choice",
        "default": "system",
        "options": [
          {
            "value": "system",
            "label": "System setting"
          },
          {
            "value": "walt",
            "label": "walt"
          },
          {
            "value": "conservative",
            "label": "conservative"
          },
          {
            "value": "powersave",
            "label": "powersave"
          },
          {
            "value": "performance",
            "label": "performance"
          },
          {
            "value": "schedutil",
            "label": "schedutil"
          }
        ]
      },
      {
        "id": "policy0_max_khz",
        "group": "policy0",
        "label": "Maximum frequency",
        "type": "choice",
        "default": "system",
        "options": [
          {"value": "system", "label": "System setting"},
          {"value": "1228800", "label": "1228.8 MHz"},
          {"value": "1344000", "label": "1344 MHz"},
          {"value": "1497600", "label": "1497.6 MHz"},
          {"value": "1593600", "label": "1593.6 MHz"},
          {"value": "1708800", "label": "1708.8 MHz"}
        ]
      },
      {
        "id": "policy4_governor",
        "group": "policy4",
        "label": "Frequency governor",
        "type": "choice",
        "default": "system",
        "options": [
          {
            "value": "system",
            "label": "System setting"
          },
          {
            "value": "walt",
            "label": "walt"
          },
          {
            "value": "conservative",
            "label": "conservative"
          },
          {
            "value": "powersave",
            "label": "powersave"
          },
          {
            "value": "performance",
            "label": "performance"
          },
          {
            "value": "schedutil",
            "label": "schedutil"
          }
        ]
      },
      {
        "id": "policy7_governor",
        "group": "policy7",
        "label": "Frequency governor",
        "type": "choice",
        "default": "system",
        "options": [
          {
            "value": "system",
            "label": "System setting"
          },
          {
            "value": "walt",
            "label": "walt"
          },
          {
            "value": "conservative",
            "label": "conservative"
          },
          {
            "value": "powersave",
            "label": "powersave"
          },
          {
            "value": "performance",
            "label": "performance"
          },
          {
            "value": "schedutil",
            "label": "schedutil"
          }
        ]
      }
    ],
    "presentation": {
      "icon": "cpu"
    }
  }
}
