{
  "id": "miui-activity-retention",
  "name": "MIUI Floating Window Unlimiter",
  "version": "0.1.0",
  "description": "On amethyst OS3.0.303.0.WOPINXM, applies MIUI’s floating-window retention lists to declared activities across installed apps for the current Android user. MIUI can still pin or hide windows.",
  "backend": "root",
  "runtime": "shell",
  "hooks": {
    "enable": "hook.sh",
    "disable": "hook.sh",
    "configure": "hook.sh",
    "run": "hook.sh"
  },
  "liveUpdate": {
    "fromSha256": "3a47b11bced6a87552b108d7a030dd0f2a365fe93ea40c815422ce40011fc245",
    "inspect": "hook.sh"
  },
  "quickSettings": {
    "icon": "windows",
    "behavior": "toggle"
  },
  "ui": {
    "presentation": {
      "icon": "windows"
    }
  },
  "triggers": {
    "boot": true,
    "intervalMinutes": 15
  }
}
