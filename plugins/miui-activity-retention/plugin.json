{
  "id": "miui-activity-retention",
  "name": "MIUI Floating Window Unlimiter",
  "version": "0.1.0",
  "description": "Adjusts MIUI’s floating-window retention lists.",
  "backend": "root",
  "runtime": "shell",
  "hooks": {
    "enable": "hook.sh",
    "disable": "hook.sh",
    "configure": "hook.sh",
    "run": "hook.sh"
  },
  "liveUpdate": {
    "fromSha256": "442b12aa80fa0c46b5d350cd7ea5a6f0e5713df92754e62918e7ef9104a9b1e4",
    "inspect": "hook.sh"
  },
  "quickSettings": {
    "icon": "windows",
    "behavior": "toggle"
  },
  "ui": {
    "presentation": {
      "icon": "windows",
      "description": "Patch: hide-on-new-window and restore-hidden-window activity lists, covering all installed apps for the current user. Disable restores our changes. Other MIUI limits may still apply."
    },
    "layout": "accordion"
  },
  "triggers": {
    "boot": true,
    "intervalMinutes": 15,
    "packageChanges": true
  }
}
